{
  "name": "@noir-binius/backend",
  "version": "0.1.0",
  "description": "A bb.js-compatible TypeScript backend for proving Noir circuits with Binius64",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "bun run build",
    "test": "bun test --timeout 120000"
  },
  "peerDependencies": {
    "@noir-lang/noir_js": "1.0.0-beta.18"
  },
  "devDependencies": {
    "@noir-lang/noir_js": "1.0.0-beta.18",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "noir",
    "binius",
    "zero-knowledge",
    "zkp"
  ]
}
